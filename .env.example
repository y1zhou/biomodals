# Local development example. Copy it to .env with mode 0600, replace both
# credential placeholders, and point BIOMODALS_API_CONF_ENV at the copy.

# Required Modal service-user credentials. Never commit real values.
MODAL_TOKEN_ID=replace-with-service-user-token-id
MODAL_TOKEN_SECRET=replace-with-service-user-token-secret

# Host and browser boundary.
BIOMODALS_STATE_DIR=.biomodals/state
BIOMODALS_CACHE_DIR=.biomodals/cache
# Soft warning only; the backend does not evict or reject Results at this size.
BIOMODALS_CACHE_WARNING_BYTES=1099511627776
BIOMODALS_PUBLIC_URL=http://localhost:5173
BIOMODALS_SECURE_COOKIES=false

# Runtime defaults. Modal App names are startup-only. Admin database values may
# override the other fields; explicit process variables override both and make
# the corresponding Admin field read-only.
BIOMODALS_MODAL_ENVIRONMENT=production
# Concurrent Modal Volume download blocks per Job.
BIOMODALS_MODAL_DOWNLOAD_CONCURRENCY=4
BIOMODALS_GROMACS_APP=Gromacs
# Exact integer shown by `modal app history Gromacs --env production --json`.
BIOMODALS_GROMACS_APP_VERSION=1
BIOMODALS_GROMACS_ACTIVE_LIMIT=2
BIOMODALS_ALPHAFOLD3_APP=AlphaFold3
BIOMODALS_ALPHAFOLD3_APP_VERSION=1
BIOMODALS_ALPHAFOLD3_ACTIVE_LIMIT=2
BIOMODALS_HUMANIZATION_APP=HumanizationWorkflow
# Replace with the exact deployment built from the matching backend checkout.
BIOMODALS_HUMANIZATION_APP_VERSION=1
BIOMODALS_HUMANIZATION_ACTIVE_LIMIT=2
# Website admission: 1-200; independent of the CLI parser limit.
BIOMODALS_HUMANIZATION_MAX_PAIRS=100
BIOMODALS_GLOBAL_ACTIVE_JOB_LIMIT=10
BIOMODALS_DEFAULT_USER_ACTIVE_JOB_LIMIT=2

# Background lifecycle behavior.
BIOMODALS_RECONCILE_SECONDS=60
