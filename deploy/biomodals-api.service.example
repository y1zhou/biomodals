[Unit]
Description=BioModals API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=biomodals
Group=biomodals
WorkingDirectory=/opt/biomodals/current/biomodals
Environment=BIOMODALS_API_CONF_ENV=/etc/biomodals/production.env
ExecStart=/opt/biomodals/current/biomodals/.venv/bin/biomodals api serve --host 127.0.0.1 --port 8000
UMask=0077
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=biomodals-api
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
