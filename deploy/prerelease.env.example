# Pre-release must use a different file, database, and cache from production.
# Install as /etc/biomodals/prerelease.env with mode 0600.
BIOMODALS_PUBLIC_URL=https://beta.aidd.y1zhou.com
BIOMODALS_SECURE_COOKIES=true
BIOMODALS_STATE_DIR=/var/lib/biomodals/prerelease/state
BIOMODALS_CACHE_DIR=/var/cache/biomodals/prerelease
BIOMODALS_CACHE_WARNING_BYTES=1099511627776

# The Modal environment remains an explicit choice. Sharing production is
# allowed only when the service User has been intentionally authorized.
BIOMODALS_MODAL_ENVIRONMENT=production
BIOMODALS_GROMACS_APP=Gromacs
BIOMODALS_DEFAULT_USER_ACTIVE_JOB_LIMIT=1
BIOMODALS_GROMACS_ACTIVE_LIMIT=1
BIOMODALS_GLOBAL_ACTIVE_JOB_LIMIT=1
BIOMODALS_RECONCILE_SECONDS=10

MODAL_TOKEN_ID=replace-with-prerelease-service-token-id
MODAL_TOKEN_SECRET=replace-with-prerelease-service-token-secret
