# Copy values into /etc/biomodals/production.env using mode 0600 and
# ownership by the biomodals service user. Never deploy this example itself.
BIOMODALS_PUBLIC_URL=https://aidd.y1zhou.com
BIOMODALS_SECURE_COOKIES=true
BIOMODALS_STATE_DIR=/var/lib/biomodals/production/state
BIOMODALS_CACHE_DIR=/var/cache/biomodals/production
BIOMODALS_CACHE_WARNING_BYTES=1099511627776

# Runtime defaults may be overridden later through the Admin interface.
BIOMODALS_MODAL_ENVIRONMENT=production
BIOMODALS_GROMACS_APP=Gromacs
BIOMODALS_DEFAULT_USER_ACTIVE_JOB_LIMIT=2
BIOMODALS_GROMACS_ACTIVE_LIMIT=2
BIOMODALS_GLOBAL_ACTIVE_JOB_LIMIT=10
BIOMODALS_RECONCILE_SECONDS=10

# Required service-user credentials. Replace both placeholders.
MODAL_TOKEN_ID=replace-with-service-token-id
MODAL_TOKEN_SECRET=replace-with-service-token-secret
